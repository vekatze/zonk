{
  target {
    test {
      main "_test.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    bench {
      main "_bench.nt",
    },
  },
  dependency {
    core {
      digest "fBLjigwWrBHLIDfDuIp73l0xLEnF9gCrf-cVnf0VOZU",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.10.tar.zst",
      ],
      enable-preset true,
    },
    _noa {
      digest "hh5RCQuivnfUzdkv4dZEG2xcdIKbjKt3bhcBuoR7gNQ",
      mirror [
        "https://github.com/vekatze/noa/raw/main/archive/0.5.7.tar.zst",
      ],
    },
  },
  inline-limit 1000000,
}
