import {
  core.float.parse {parse-float},
  core.function {compose},
  core.int.parse {parse-int},
  core.list {reverse},
  this.parse {
    drop-while,
    parsed,
    report-unexpected-input,
    take-while,
    zonk,
  },
}

define _is-space(r: rune) -> bool {
  if eq-rune(r, ` `) {
    True
  } else-if and(le-rune(`\u{9}`, r), le-rune(r, `\u{D}`)) {
    True
  } else {
    False
  }
}

constant skip-space<c>: zonk(c, unit) {
  drop-while(_is-space)
}

define _any-number(r: rune) -> bool {
  let b1 = le-rune(`0`, r);
  let b2 = le-rune(r, `9`);
  and(b1, b2)
}

define _is-integer-rune(r: rune) -> bool {
  or(
    _any-number(r),
    or(
      eq-rune(r, `+`),
      eq-rune(r, `-`),
    ),
  )
}

define _is-float-rune(r: rune) -> bool {
  or(
    _any-number(r),
    or(
      eq-rune(r, `.`),
      or(
        eq-rune(r, `e`),
        or(
          eq-rune(r, `E`),
          or(
            eq-rune(r, `+`),
            eq-rune(r, `-`),
          ),
        ),
      ),
    ),
  )
}

inline read-symbol<c>() -> zonk(c, string) {
  (k) =>> {
    try result = take-while(compose(not, _is-space))(k);
    try _ = skip-space(k);
    Right(result)
  }
}

constant read-int<c>: zonk(c, int) {
  (k) =>> {
    try num-string = take-while(_is-integer-rune)(k);
    try _ = skip-space(k);
    let none-or-int on num-string = parse-int(num-string);
    let _ = num-string;
    match none-or-int {
    | Left(_) =>
      report-unexpected-input("integer")
    | Right(v) =>
      Right(v)
    }
  }
}

constant read-float<c>: zonk(c, float) {
  (k) =>> {
    try num-string = take-while(_is-float-rune)(k);
    try _ = skip-space(k);
    let none-or-float on num-string = parse-float(num-string);
    let _ = num-string;
    match none-or-float {
    | Left(_) =>
      report-unexpected-input("float")
    | Right(v) =>
      Right(v)
    }
  }
}

define read-int-list<c>(size: int) -> zonk(c, list(int)) {
  (k) =>> {
    let f =
      define self(cursor: int, acc: list(int)) -> parsed(list(int)) {
        if le-int(cursor, 0) {
          Right(reverse(acc))
        } else {
          try v = read-int(k);
          self(sub-int(cursor, 1), Cons(v, acc))
        }
      };
    f(size, Nil)
  }
}

inline read-vector<c, a>(size: int, !p: zonk(c, a)) -> zonk(c, vector(a)) {
  (k) =>> {
    let f =
      define self(cursor: int, acc: vector(a)) -> parsed(vector(a)) {
        if ge-int(cursor, size) {
          Right(acc)
        } else {
          try v = p(k);
          try _ = skip-space(k);
          self(add-int(cursor, 1), core.vector.push-back(acc, v))
        }
      };
    try result = f(0, core.vector.make(size));
    Right(result)
  }
}

define read-int-vector<c>(size: int) -> zonk(c, vector(int)) {
  read-vector(size, read-int)
}

define read-float-list<c>(size: int) -> zonk(c, list(float)) {
  (k) =>> {
    let f =
      define self(cursor: int, acc: list(float)) -> parsed(list(float)) {
        if le-int(cursor, 0) {
          Right(reverse(acc))
        } else {
          try v = read-float(k);
          try _ = skip-space(k);
          self(sub-int(cursor, 1), Cons(v, acc))
        }
      };
    f(size, Nil)
  }
}

define read-float-vector<c>(size: int) -> zonk(c, vector(float)) {
  read-vector(size, read-float)
}
