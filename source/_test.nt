import {
  core.bool {all},
  core.eq.generic {eq-data},
  core.string {byte-length},
  noa.check {check},
  noa.gen.string {string-gen},
  noa.noa-kit {make-default-noa-kit},
  noa.test {test},
  this.parse {
    Parse-Error,
    Point,
    choice,
    chunk,
    drop-while,
    end-of-input,
    make-parse-error,
    make-zonk-kit,
    many,
    report,
    satisfy,
    some,
    take-while,
    zonk,
  },
}

define main() -> unit {
  pin k = make-default-noa-kit();
  test(
    k,
    "chunk(prefix) succeeds and leaves the remainder",
    () => {
      pin k = make-zonk-kit(*"fooあい-bar", Unit);
      let p: zonk(unit, bool) =
        (k) =>> {
          try _ = chunk(static "fooあい")(k);
          try rest =
            take-while((_) => {
              True
            })(k);
          try _ = end-of-input(k);
          let result on rest = eq-string("-bar", rest);
          let _ = rest;
          Right(result)
        };
      match p(k) {
      | Right(result) =>
        result
      | Left(_) =>
        False
      }
    },
  );
  test(
    k,
    "chunk(whole) → end-of-input succeeds",
    () => {
      pin k = make-zonk-kit(*"helloあ", Unit);
      let p: zonk(unit, unit) =
        (k) =>> {
          try _ = chunk(static "helloあ")(k);
          try _ = end-of-input(k);
          Right(Unit)
        };
      match p(k) {
      | Right(_) =>
        True
      | Left(_) =>
        False
      }
    },
  );
  test(
    k,
    "chunk → chunk → end-of-input succeeds on the concatenation",
    () => {
      pin k = make-zonk-kit(*"fooあいbar", Unit);
      let p: zonk(unit, unit) =
        (k) =>> {
          try _ = chunk(static "fooあい")(k);
          try _ = chunk(static "bar")(k);
          try _ = end-of-input(k);
          Right(Unit)
        };
      match p(k) {
      | Right(_) =>
        True
      | Left(_) =>
        False
      }
    },
  );
  check::(
    k,
    "for any non-empty string, end-of-input must fail",
    string-gen,
    (t) => {
      let len on t = byte-length(t);
      if eq-int(len, 0) {
        True
      } else {
        pin k = make-zonk-kit(t, Unit);
        let result =
          match end-of-input(k) {
          | Right(_) =>
            False
          | Left(_) =>
            True
          };
        result
      }
    },
  );
  test(
    k,
    "take-while, chunk, take-while",
    () => {
      pin k = make-zonk-kit(*"xxx\nbar", Unit);
      let my-parser: zonk(unit, unit) =
        (k) =>> {
          try _ =
            take-while((r) => {
              eq-rune(r, `x`)
            })(k);
          try _ = chunk(static "\n")(k);
          try _ =
            take-while((r) => {
              ne-rune(r, `x`)
            })(k);
          Right(Unit)
        };
      match my-parser(k) {
      | Right(_) =>
        True
      | Left(_) =>
        False
      }
    },
  );
  test(
    k,
    "drop-while, chunk, drop-while",
    () => {
      pin k = make-zonk-kit(*"xxx\nbar", Unit);
      let my-parser: zonk(unit, unit) =
        (k) =>> {
          try _ =
            drop-while((r) => {
              eq-rune(r, `x`)
            })(k);
          try _ = chunk(static "\n")(k);
          try _ =
            drop-while((r) => {
              ne-rune(r, `x`)
            })(k);
          Right(Unit)
        };
      match my-parser(k) {
      | Right(_) =>
        True
      | Left(_) =>
        False
      }
    },
  );
  test(
    k,
    "report error locations correctly (take-while, chunk)",
    () => {
      pin k = make-zonk-kit(*"xxx\nbar", Unit);
      let my-parser: zonk(unit, unit) =
        (k) =>> {
          try _ =
            take-while((r) => {
              eq-rune(r, `x`)
            })(k);
          try _ = chunk(static "\n")(k);
          try _ = chunk(static "a")(k);
          Right(Unit)
        };
      match my-parser(k) {
      | Right(_) =>
        False
      | Left(_) =>
        let Parse-Error{error-location} = make-parse-error(k);
        pin actual = error-location;
        pin expected = Point(1, 0);
        eq-data::(actual, expected)
      }
    },
  );
  test(
    k,
    "report error locations correctly (drop-while, chunk)",
    () => {
      pin k = make-zonk-kit(*"xxx\nbar", Unit);
      let my-parser: zonk(unit, unit) =
        (k) =>> {
          try _ =
            drop-while((r) => {
              all[
                ne-rune(r, `y`),
                ne-rune(r, `\n`),
              ]
            })(k);
          try _ = chunk(static "\n")(k);
          try _ = chunk(static "a")(k);
          Right(Unit)
        };
      match my-parser(k) {
      | Right(_) =>
        False
      | Left(_) =>
        let Parse-Error{error-location} = make-parse-error(k);
        pin actual = error-location;
        pin expected = Point(1, 0);
        eq-data::(actual, expected)
      }
    },
  );
  test(
    k,
    "report error locations correctly (satisfy, chunk)",
    () => {
      pin k = make-zonk-kit(*"xxx\nbar", Unit);
      let my-parser: zonk(unit, unit) =
        (k) =>> {
          try _ =
            drop-while((r) => {
              all[
                ne-rune(r, `y`),
                ne-rune(r, `\n`),
              ]
            })(k);
          try _ =
            satisfy(static "foo", (r) => {
              eq-rune(r, `\n`)
            })(k);
          try _ = chunk(static "a")(k);
          Right(Unit)
        };
      match my-parser(k) {
      | Right(_) =>
        False
      | Left(_) =>
        let Parse-Error{error-location} = make-parse-error(k);
        pin actual = error-location;
        pin expected = Point(1, 0);
        eq-data::(actual, expected)
      }
    },
  );
}

constant _sample-parser: zonk(unit, unit) {
  // constructs a parser
  (k) =>> {
    // accepts: foo
    try _ = chunk(static "foo")(k);
    // accepts: (buz|test|bar)
    try _ = choice(static "buz, test, or bar", List[chunk(static "buz"), chunk(static "test")], chunk(static "bar"))(k);
    // accepts: (qux)+
    try _ = some(chunk(static "qux"))(k);
    // accepts: (yo)*
    try _ = many(chunk(static "yo"))(k);
    // accepts: end-of-input
    try _ = end-of-input(k);
    Right(Unit)
  }
}

define zen() -> unit {
  pin k = make-zonk-kit(*"fooXXXXquxquxyoyoyoyo", Unit);
  match _sample-parser(k) {
  | Right(_) =>
    print("pass\n")
  | Left(_) =>
    let err = make-parse-error(k);
    pin err = report(err);
    print("fail: ");
    print-line(err);
  }
}
