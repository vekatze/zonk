import {
  core.list {for-each},
  this.parse {
    attempt,
    branch,
    chunk,
    end-of-input,
    label,
    make-parse-error,
    make-zonk-kit,
    parsed,
    report,
    satisfy,
    zonk,
  },
  this.regex {Any, Choose, Chunk, End-Of-Input, Join, Repeat, regex},
}

define _rune-member(r: rune, rs: &list(rune)) -> bool {
  case rs {
  | Nil =>
    False
  | Cons(r-cand, rest) =>
    if eq-rune(r, *r-cand) {
      True
    } else {
      _rune-member(r, rest)
    }
  }
}

define _from-regex<c>(reg: regex) -> zonk(c, unit) {
  match reg {
  | Any(label, rs) =>
    (k) =>> {
      try _ =
        satisfy(label, (r) => {
          let found on rs = _rune-member(r, rs);
          let _ = rs;
          found
        })(k);
      Right(Unit)
    }
  | Chunk(t) =>
    chunk(t)
  | Choose(name, xs, fallback) =>
    let xs = for-each(xs, exact _from-regex);
    let fallback = _from-regex(fallback);
    let go =
      define loop(xs: list(zonk(c, unit)), fallback: zonk(c, unit)) -> zonk(c, unit) {
        match xs {
        | Nil =>
          fallback
        | Cons(x, rest) =>
          branch(attempt(x), loop(rest, fallback))
        }
      };
    label(name, go(xs, fallback))
  | Join(xs) =>
    let xs = for-each(xs, exact _from-regex);
    let go =
      define loop(xs: list(zonk(c, unit))) -> zonk(c, unit) {
        match xs {
        | Nil =>
          (_) =>> {
            Right(Unit)
          }
        | Cons(x, xs) =>
          (k) =>> {
            try _ = x(k);
            loop(xs)(k)
          }
        }
      };
    go(xs)
  | Repeat(r) =>
    let !p = attempt(_from-regex(r));
    (k) =>> {
      let go =
        define self() -> parsed(unit) {
          match p(k) {
          | Right(_) =>
            self()
          | Left(_) =>
            Right(Unit)
          }
        };
      go()
    }
  | End-Of-Input =>
    end-of-input
  }
}

inline recognize(r: regex, input: string) -> bool {
  pin k = make-zonk-kit(input, pack-type {unit});
  match _from-regex(r)(k) {
  | Right(_) =>
    True
  | Left(_) =>
    pin t = report(make-parse-error(k));
    print-line(t);
    False
  }
}
