import {
  core.list {any, for-each},
  this.parse {
    attempt,
    branch,
    chunk,
    end-of-input,
    label,
    make-parse-error,
    make-zonk-kit,
    many,
    report,
    satisfy,
    zonk,
  },
  this.regex {Any, Choose, Chunk, End-Of-Input, Join, Repeat, regex},
}

define _from-regex<c>(reg: regex) -> zonk(c, unit) {
  match reg {
  | Any(label, rs) =>
    (k) =>> {
      try _ =
        satisfy(label, (r) => {
          let bs =
            for-each(rs, (r-cand) => {
              eq-rune(r, r-cand)
            });
          any(bs)
        })(k);
      Right(Unit)
    }
  | Chunk(t) =>
    chunk(t)
  | Choose(name, xs, fallback) =>
    let xs = for-each(xs, exact _from-regex);
    let fallback = _from-regex(fallback);
    let go =
      define loop(xs: list(zonk(c, unit)), fallback: zonk(c, unit)) -> zonk(c, unit) {
        match xs {
        | Nil =>
          fallback
        | Cons(x, rest) =>
          branch(attempt(x), loop(rest, fallback))
        }
      };
    label(name, go(xs, fallback))
  | Join(xs) =>
    let xs = for-each(xs, exact _from-regex);
    let go =
      define loop(xs: list(zonk(c, unit))) -> zonk(c, unit) {
        match xs {
        | Nil =>
          (_) =>> {
            Right(Unit)
          }
        | Cons(x, xs) =>
          (k) =>> {
            try _ = x(k);
            loop(xs)(k)
          }
        }
      };
    go(xs)
  | Repeat(r) =>
    (k) =>> {
      try _ = many(attempt(_from-regex(r)))(k);
      Right(Unit)
    }
  | End-Of-Input =>
    end-of-input
  }
}

inline recognize(r: regex, input: string) -> bool {
  pin k = make-zonk-kit(input, pack-type {unit});
  match _from-regex(r)(k) {
  | Right(_) =>
    True
  | Left(e) =>
    pin t = report(make-parse-error(k, e));
    print-line(t);
    False
  }
}
