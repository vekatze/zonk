import {
  this.parse {
    choice,
    chunk,
    end-of-input,
    label,
    make-parse-error,
    make-zonk-kit,
    report,
  },
}

define zen() -> unit {
  let my-parser =
    choice(
      static "some term",
      List[
        (k) =>> {
          try _ = chunk(static "gaoe")(k);
          try _ = chunk(static "item")(k);
          Right(Unit)
        },
        choice(static "item", List[chunk(static "k")], label(static "whatever", (k) =>> {
          try _ = chunk(static "px")(k);
          try _ = chunk(static "kgあ")(k);
          Right(Unit)
        })),
        chunk(static "tあい"),
        label(static "whatever 2", (k) =>> {
          try _ = chunk(static "pt")(k);
          try _ = chunk(static "あhebc")(k);
          Right(Unit)
        }),
        chunk(static "abc"),
        chunk(static "{}"),
        end-of-input,
      ],
      chunk(static "tn"),
    );
  pin k = make-zonk-kit(*"gaxoeitemtesttnapqabcd\nctああhehoge \n\r  hehehetest", Unit);
  let my-result = my-parser(k);
  match my-result {
  | Left(_) =>
    let err = make-parse-error(k);
    pin message = report(err);
    print("left: ");
    print-line(message);
  | Right(_) =>
    print("right\n")
  }
}
