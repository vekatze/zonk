import {
  core.box {axiom-T},
  core.cell {borrow, cell, make-cell, mutate},
  core.int {max-int},
  core.int.show {show-int},
  core.list {reverse},
  core.rune,
  core.string {byte-length, format, take-N},
  core.string.show {show-string, show-string-N},
  core.string.unsafe {drop-N, get-rune-unchecked, slice-N},
}

data expected-item {
| _Raw-Text(&string)
| _Label(&string)
}

define _show-expected-item(k: expected-item) -> string {
  match k {
  | _Raw-Text(t) =>
    show-string-N(t)
  | _Label(t) =>
    *t
  }
}

data point {
| Point(
    row: int,
    column: int,
  )
}

define show-point(p: point) -> string {
  let Point{row, column} = p;
  format("row {}, column {}", List[show-int(add-int(row, 1)), show-int(add-int(column, 1))])
}

data parse-error {
| Parse-Error(
    found: string,
    expected: expected-item,
    error-location: point,
  )
}

define report(e: parse-error) -> string {
  let Parse-Error{found, expected, error-location} = e;
  let error-location = show-point(error-location);
  format("parse error at {}:\nexpected:\n  {}\nfound:\n  {}", List[error-location, _show-expected-item(expected), found])
}

data position {
| _Position(
    cursor: int,
    line: int,
    column: int,
    gap-size: int,
  )
}

data zonk-kit(a) {
| _Zonk-Kit(
    input-stream: string,
    position-cell: cell(position),
    context: a,
  )
}

define make-zonk-kit<c>(input-stream: string, context: c) ->> zonk-kit(c) {
  let position-cell = make-cell(lift {_Position(0, 0, 0, 0)});
  _Zonk-Kit{input-stream, position-cell, context}
}

define get-context<c>(k: &zonk-kit(c)) -> &c {
  tie _Zonk-Kit{context} = k;
  context
}

define _get-position<c>(k: &zonk-kit(c)) -> position {
  tie _Zonk-Kit{position-cell} = k;
  borrow(position-cell, (position) => {
    lift {*position}
  })
}

inline _set-position<c>(k: &zonk-kit(c), new-position: position) -> unit {
  tie _Zonk-Kit{position-cell} = k;
  mutate(position-cell, (_) => {
    lift {new-position}
  })
}

define _get-input-stream<c>(k: &zonk-kit(c)) -> &string {
  tie _Zonk-Kit{input-stream} = k;
  input-stream
}

define _get-cursor<c>(k: &zonk-kit(c)) -> int {
  tie _Zonk-Kit{position-cell} = k;
  borrow(position-cell, (position) => {
    tie _Position{cursor} = position;
    lift {*cursor}
  })
}

define _get-gap-size<c>(k: &zonk-kit(c)) -> int {
  tie _Zonk-Kit{position-cell} = k;
  borrow(position-cell, (position) => {
    tie _Position{gap-size} = position;
    lift {*gap-size}
  })
}

inline _set-gap-size<c>(k: &zonk-kit(c), new-gap-size: int) -> unit {
  tie _Zonk-Kit{position-cell} = k;
  mutate(position-cell, (position) => {
    let _Position{cursor, line, column, gap-size} = axiom-T(position);
    lift {_Position{cursor, line, column, gap-size := max-int(gap-size, new-gap-size)}}
  })
}

inline _advance-point(line: int, column: int, r: rune) ->> point {
  if eq-rune(r, `\n`) {
    Point(add-int(line, 1), 0)
  } else {
    Point(line, add-int(column, 1))
  }
}

inline _set-new-position<c>(k: &zonk-kit(c), cursor: int, line: int, column: int) -> unit {
  tie _Zonk-Kit{position-cell} = k;
  mutate(position-cell, (position) => {
    let _Position{gap-size} = axiom-T(position);
    lift {_Position{cursor, line, column, gap-size}}
  })
}

define make-parse-error<c>(k: &zonk-kit(c), expected: expected-item) ->> parse-error {
  let input-stream = _get-input-stream(k);
  let _Position{cursor, line, column, gap-size} = _get-position(k);
  let input-stream = drop-N(input-stream, cursor);
  let found on input-stream = show-string(take-N(input-stream, gap-size));
  let _ = input-stream;
  Parse-Error{
    expected,
    found,
    error-location := Point(line, column),
  }
}

alias parsed(a) {
  either(expected-item, a)
}

alias zonk(c, a) {
  (&zonk-kit(c)) ->> parsed(a)
}

inline report-unexpected-input<a>(label: &string) -> parsed(a) {
  Left(_Label(label))
}

inline get-point<c>(k: &zonk-kit(c)) -> point {
  tie _Zonk-Kit{position-cell} = k;
  borrow(position-cell, (position) => {
    tie _Position{line, column} = position;
    lift {Point(*line, *column)}
  })
}

constant end-of-input<c>: zonk(c, unit) {
  (k) =>> {
    let input-stream = _get-input-stream(k);
    let cursor = _get-cursor(k);
    let len = byte-length(input-stream);
    if ge-int(cursor, len) {
      Right(Unit)
    } else {
      _set-gap-size(k, 1);
      Left(_Label("endinput"))
    }
  }
}

inline satisfy<c>(label: &string, p: (rune) -> bool) ->> zonk(c, rune) {
  (k) =>> {
    let input-stream = _get-input-stream(k);
    let len = byte-length(input-stream);
    let _Position{cursor, line, column, gap-size} = _get-position(k);
    if ge-int(cursor, len) {
      Left(_Label(label))
    } else {
      let r = get-rune-unchecked(input-stream, cursor);
      if p(r) {
        let Point(line, column) = _advance-point(line, column, r);
        _set-position(k, _Position{cursor := add-int(cursor, core.rune.size(r)), line, column, gap-size});
        Right(r)
      } else {
        _set-gap-size(k, 1);
        Left(_Label(label))
      }
    }
  }
}

constant any-rune<c>: zonk(c, rune) {
  satisfy("any character", (_) => {
    True
  })
}

define _chunk-body<c>(k: &zonk-kit(c), chunk-string: &string) -> int {
  let input-stream = _get-input-stream(k);
  let _Position{cursor, line, column} = _get-position(k);
  let len1 = byte-length(input-stream);
  let len2 = byte-length(chunk-string);
  if lt-int(sub-int(len1, cursor), len2) {
    -1
  } else {
    let f =
      define _chunk-consumer(
        index: int,
        line: int,
        column: int,
      ) -> int {
        if eq-int(index, len2) {
          _set-new-position(k, add-int(cursor, len2), line, column);
          1
        } else {
          let rune1 = get-rune-unchecked(input-stream, add-int(cursor, index));
          let rune2 = get-rune-unchecked(chunk-string, index);
          let offset = core.rune.size(rune1);
          if eq-rune(rune1, rune2) {
            if eq-rune(rune1, `\n`) {
              _chunk-consumer(add-int(index, offset), add-int(line, 1), 0)
            } else {
              _chunk-consumer(add-int(index, offset), line, add-int(column, 1))
            }
          } else {
            _set-gap-size(k, core.string.length(chunk-string));
            -1
          }
        }
      };
    if eq-int(len2, 0) {
      1
    } else {
      f(0, line, column)
    }
  }
}

inline chunk<c>(chunk-string: &string) ->> zonk(c, unit) {
  (k) =>> {
    let result-flag = _chunk-body(k, chunk-string);
    if gt-int(result-flag, 0) {
      Right(Unit)
    } else {
      Left(_Raw-Text(chunk-string))
    }
  }
}

inline take-while<c>(!p: (rune) -> bool) ->> zonk(c, string) {
  (k) =>> {
    let input-stream = _get-input-stream(k);
    let len = byte-length(input-stream);
    let _Position{cursor, line, column} = _get-position(k);
    let orig-cursor = cursor;
    let f =
      define consumer(cursor: int, line: int, column: int) -> string {
        if ge-int(cursor, len) {
          _set-new-position(k, cursor, line, column);
          slice-N(input-stream, orig-cursor, sub-int(cursor, orig-cursor))
        } else {
          let r = get-rune-unchecked(input-stream, cursor);
          if p(r) {
            let Point(line, column) = _advance-point(line, column, r);
            consumer(add-int(cursor, core.rune.size(r)), line, column)
          } else {
            _set-new-position(k, cursor, line, column);
            slice-N(input-stream, orig-cursor, sub-int(cursor, orig-cursor))
          }
        }
      };
    Right(f(cursor, line, column))
  }
}

inline take-while-1<c>(!p: (rune) -> bool) ->> zonk(c, string) {
  (k) =>> {
    let input-stream = _get-input-stream(k);
    let len = byte-length(input-stream);
    let _Position{cursor, line, column} = _get-position(k);
    let orig-cursor = cursor;
    let f =
      define consumer(cursor: int, line: int, column: int) -> parsed(string) {
        if ge-int(cursor, len) {
          let size = sub-int(cursor, orig-cursor);
          if gt-int(size, 0) {
            _set-new-position(k, cursor, line, column);
            Right(slice-N(input-stream, orig-cursor, size))
          } else {
            Left(_Label("non-empty string"))
          }
        } else {
          let r = get-rune-unchecked(input-stream, cursor);
          if p(r) {
            let Point(line, column) = _advance-point(line, column, r);
            consumer(add-int(cursor, core.rune.size(r)), line, column)
          } else {
            let size = sub-int(cursor, orig-cursor);
            if gt-int(size, 0) {
              _set-new-position(k, cursor, line, column);
              Right(slice-N(input-stream, orig-cursor, size))
            } else {
              Left(_Label("non-empty string"))
            }
          }
        }
      };
    f(cursor, line, column)
  }
}

inline drop-while<c>(!p: (rune) -> bool) ->> zonk(c, unit) {
  (k) =>> {
    let input-stream = _get-input-stream(k);
    let len = byte-length(input-stream);
    let _Position{cursor, line, column} = _get-position(k);
    let f =
      define consumer(cursor: int, line: int, column: int) -> unit {
        if ge-int(cursor, len) {
          _set-new-position(k, cursor, line, column)
        } else {
          let r = get-rune-unchecked(input-stream, cursor);
          if p(r) {
            let Point(line, column) = _advance-point(line, column, r);
            consumer(add-int(cursor, core.rune.size(r)), line, column)
          } else {
            _set-new-position(k, cursor, line, column)
          }
        }
      };
    Right(f(cursor, line, column))
  }
}

define _is-ascii-space(r: rune) -> bool {
  if eq-rune(r, ` `) {
    True
  } else-if and(le-rune(`\u{9}`, r), le-rune(r, `\u{D}`)) {
    True
  } else {
    False
  }
}

constant ascii-space<c>: zonk(c, unit) {
  drop-while(_is-ascii-space)
}

inline label<c, a>(l: &string, p: zonk(c, a)) ->> zonk(c, a) {
  (k) =>> {
    let v = p(k);
    match v {
    | Right(result) =>
      Right(result)
    | Left(_) =>
      Left(_Label(l))
    }
  }
}

define _attempt-body<c, a>(k: &zonk-kit(c), position: position, v: parsed(a)) ->> parsed(a) {
  match v {
  | Right(result) =>
    Right(result)
  | Left(e) =>
    _set-position(k, position);
    Left(e)
  }
}

inline attempt<c, a>(p: zonk(c, a)) ->> zonk(c, a) {
  (k) =>> {
    let position = _get-position(k);
    _attempt-body(k, position, p(k))
  }
}

define _look-ahead-body<c, a>(k: &zonk-kit(c), position: position, v: parsed(a)) -> parsed(a) {
  match v {
  | Right(result) =>
    _set-position(k, position);
    Right(result)
  | Left(e) =>
    Left(e)
  }
}

inline look-ahead<c, a>(p: zonk(c, a)) ->> zonk(c, a) {
  (k) =>> {
    let position = _get-position(k);
    _look-ahead-body(k, position, p(k))
  }
}

define _optional-body<a>(v: parsed(a)) -> parsed(?a) {
  match v {
  | Right(result) =>
    Right(Right(result))
  | Left(_) =>
    Right(Left(Unit))
  }
}

inline optional<c, a>(p: zonk(c, a)) ->> zonk(c, ?a) {
  (k) =>> {
    _optional-body(p(k))
  }
}

inline branch<c, a>(p1: zonk(c, a), p2: zonk(c, a)) ->> zonk(c, a) {
  (k) =>> {
    match p1(k) {
    | Right(result) =>
      Right(result)
    | Left(_) =>
      p2(k)
    }
  }
}

define _not-followed-by-body<c, a>(
  k: &zonk-kit(c),
  position: position,
  v: parsed(a),
) -> bool {
  _set-position(k, position);
  match v {
  | Left(_) =>
    True
  | Right(_) =>
    _set-gap-size(k, 1);
    False
  }
}

inline not-followed-by<c, a>(label: &string, p: zonk(c, a)) ->> zonk(c, unit) {
  (k) =>> {
    let position = _get-position(k);
    let result = _not-followed-by-body(k, position, p(k));
    if result {
      Right(Unit)
    } else {
      Left(_Label(label))
    }
  }
}

define _choice<c, a>(
  k: &zonk-kit(c),
  label: &string,
  candidates: list(zonk(c, a)),
  fallback: zonk(c, a),
  default-gap-size: int,
) ->> parsed(a) {
  match candidates {
  | Nil =>
    match fallback(k) {
    | Right(v) =>
      _set-gap-size(k, default-gap-size);
      Right(v)
    | Left(_) =>
      Left(_Label(label))
    }
  | Cons(cand, rest) =>
    match cand(k) {
    | Right(v) =>
      _set-gap-size(k, default-gap-size);
      Right(v)
    | Left(_) =>
      _choice(k, label, rest, fallback, default-gap-size)
    }
  }
}

inline choice<c, a>(label: &string, candidates: list(zonk(c, a)), fallback: zonk(c, a)) ->> zonk(c, a) {
  (k) =>> {
    match candidates {
    | Nil =>
      fallback(k)
    | Cons(p, rest) =>
      let old-cursor = _get-cursor(k);
      match p(k) {
      | Right(v) =>
        Right(v)
      | Left(e) =>
        let new-cursor = _get-cursor(k);
        if eq-int(old-cursor, new-cursor) {
          let gap-size = _get-gap-size(k);
          _choice(k, label, rest, fallback, gap-size)
        } else {
          Left(e)
        }
      }
    }
  }
}

inline many<c, a>(!p: zonk(c, a)) -> zonk(c, list(a)) {
  (k) =>> {
    let f =
      define self(acc: list(a)) ->> parsed(list(a)) {
        match p(k) {
        | Right(v) =>
          self(Cons(v, acc))
        | Left(_) =>
          Right(reverse(acc))
        }
      };
    f(Nil)
  }
}

inline some<c, a>(!p: zonk(c, a)) ->> zonk(c, list(a)) {
  (k) =>> {
    try v = p(k);
    try vs = many(p)(k);
    Right(Cons(v, vs))
  }
}
