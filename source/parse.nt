import {
  core.box {axiom-T},
  core.c-size {C-Size, c-size},
  core.cell {borrow, cell, make-cell, mutate},
  core.int {max-int},
  core.int.show {show-int},
  core.list {reverse},
  core.pointer {shift},
  core.rune,
  core.string {byte-length, format, from-text, take-N, with-byte-slice},
  core.string.pointer {get-content-pointer},
  core.string.show {show-string, show-string-N},
  core.string.unsafe {drop-N, get-rune-unchecked, slice-N},
}

foreign {
  memcmp(pointer, pointer, c-size) -> int,
}

data expected-item {
| _Raw-Text(&string)
| _Label(&string)
}

define _show-expected-item(k: expected-item) -> string {
  match k {
  | _Raw-Text(t) =>
    show-string-N(t)
  | _Label(t) =>
    *t
  }
}

data point {
| Point(
    row: int,
    column: int,
  )
}

define show-point(p: point) -> string {
  let Point{row, column} = p;
  format("row {}, column {}", List[show-int(add-int(row, 1)), show-int(add-int(column, 1))])
}

data parse-error {
| Parse-Error(
    found: string,
    expected: expected-item,
    error-location: point,
  )
}

define report(e: parse-error) -> string {
  let Parse-Error{found, expected, error-location} = e;
  let error-location = show-point(error-location);
  format("parse error at {}:\nexpected:\n  {}\nfound:\n  {}", List[error-location, _show-expected-item(expected), found])
}

data zonk-kit(a) {
| _Zonk-Kit(
    input-stream: string,
    cursor: cell(int),
    gap-size: cell(int),
    point-cursor: cell(int),
    point-line: cell(int),
    point-column: cell(int),
    expected-is-raw: cell(int),
    expected-text: cell(text),
    context: a,
  )
}

define make-zonk-kit<c>(input-stream: string, context: c) ->> zonk-kit(c) {
  _Zonk-Kit{
    input-stream,
    cursor := make-cell(lift {0}),
    gap-size := make-cell(lift {0}),
    point-cursor := make-cell(lift {0}),
    point-line := make-cell(lift {0}),
    point-column := make-cell(lift {0}),
    expected-is-raw := make-cell(lift {0}),
    expected-text := make-cell(lift {static "unknown"}),
    context,
  }
}

define get-context<c>(k: &zonk-kit(c)) -> &c {
  tie _Zonk-Kit{context} = k;
  context
}

inline _read-int-cell(r: &cell(int)) -> int {
  borrow(r, (x) => {
    lift {*x}
  })
}

inline _write-int-cell(r: &cell(int), v: int) -> unit {
  mutate(r, (_) => {
    lift {v}
  })
}

define _get-input-stream<c>(k: &zonk-kit(c)) -> &string {
  tie _Zonk-Kit{input-stream} = k;
  input-stream
}

inline _get-cursor<c>(k: &zonk-kit(c)) -> int {
  tie _Zonk-Kit{cursor} = k;
  _read-int-cell(cursor)
}

inline _set-cursor<c>(k: &zonk-kit(c), new-cursor: int) -> unit {
  tie _Zonk-Kit{cursor} = k;
  _write-int-cell(cursor, new-cursor)
}

inline _get-gap-size<c>(k: &zonk-kit(c)) -> int {
  tie _Zonk-Kit{gap-size} = k;
  _read-int-cell(gap-size)
}

inline _set-gap-size<c>(k: &zonk-kit(c), new-gap-size: int) -> unit {
  tie _Zonk-Kit{gap-size} = k;
  mutate(gap-size, (g) => {
    lift {max-int(axiom-T(g), new-gap-size)}
  })
}

inline _reset-gap-size<c>(k: &zonk-kit(c), new-gap-size: int) -> unit {
  tie _Zonk-Kit{gap-size} = k;
  _write-int-cell(gap-size, new-gap-size)
}

inline _store-expected<c>(k: &zonk-kit(c), is-raw: int, t: text) -> unit {
  tie _Zonk-Kit{expected-is-raw, expected-text} = k;
  _write-int-cell(expected-is-raw, is-raw);
  mutate(expected-text, (_) => {
    lift {t}
  })
}

inline _set-expected-raw<c>(k: &zonk-kit(c), t: text) -> unit {
  _store-expected(k, 1, t)
}

inline _set-expected-label<c>(k: &zonk-kit(c), l: text) -> unit {
  _store-expected(k, 0, l)
}

define _get-expected<c>(k: &zonk-kit(c)) -> expected-item {
  tie _Zonk-Kit{expected-is-raw, expected-text} = k;
  let t =
    from-text(borrow(expected-text, (x) => {
      lift {*x}
    }));
  if eq-int(_read-int-cell(expected-is-raw), 1) {
    _Raw-Text(t)
  } else {
    _Label(t)
  }
}

inline _advance-point(line: int, column: int, r: rune) ->> point {
  if eq-rune(r, `\n`) {
    Point(add-int(line, 1), 0)
  } else {
    Point(line, add-int(column, 1))
  }
}

define _resolve-point<c>(k: &zonk-kit(c), target: int) -> point {
  let input-stream = _get-input-stream(k);
  tie _Zonk-Kit{point-cursor, point-line, point-column} = k;
  let base-cursor = _read-int-cell(point-cursor);
  let scan =
    define go(cursor: int, line: int, column: int) -> point {
      if ge-int(cursor, target) {
        Point(line, column)
      } else {
        let r = get-rune-unchecked(input-stream, cursor);
        let Point(line, column) = _advance-point(line, column, r);
        go(add-int(cursor, core.rune.size(r)), line, column)
      }
    };
  let Point(line, column) =
    if le-int(base-cursor, target) {
      scan(base-cursor, _read-int-cell(point-line), _read-int-cell(point-column))
    } else {
      scan(0, 0, 0)
    };
  _write-int-cell(point-cursor, target);
  _write-int-cell(point-line, line);
  _write-int-cell(point-column, column);
  Point(line, column)
}

define make-parse-error<c>(k: &zonk-kit(c)) ->> parse-error {
  let cursor = _get-cursor(k);
  let gap-size = _get-gap-size(k);
  let error-location = _resolve-point(k, cursor);
  let input-stream = _get-input-stream(k);
  let rest = drop-N(input-stream, cursor);
  let found on rest = show-string(take-N(rest, gap-size));
  let _ = rest;
  Parse-Error{
    expected := _get-expected(k),
    found,
    error-location,
  }
}

alias parsed(a) {
  either(unit, a)
}

alias zonk(c, a) {
  (&zonk-kit(c)) ->> parsed(a)
}

inline get-point<c>(k: &zonk-kit(c)) -> point {
  _resolve-point(k, _get-cursor(k))
}

constant end-of-input<c>: zonk(c, unit) {
  (k) =>> {
    let input-stream = _get-input-stream(k);
    let cursor = _get-cursor(k);
    let len = byte-length(input-stream);
    if ge-int(cursor, len) {
      Right(Unit)
    } else {
      _set-gap-size(k, 1);
      _set-expected-label(k, static "end of input");
      Left(Unit)
    }
  }
}

inline satisfy<c>(label: text, p: (rune) -> bool) ->> zonk(c, rune) {
  (k) =>> {
    let input-stream = _get-input-stream(k);
    let len = byte-length(input-stream);
    let cursor = _get-cursor(k);
    if ge-int(cursor, len) {
      _set-expected-label(k, label);
      Left(Unit)
    } else {
      let r = get-rune-unchecked(input-stream, cursor);
      if p(r) {
        _set-cursor(k, add-int(cursor, core.rune.size(r)));
        Right(r)
      } else {
        _set-gap-size(k, 1);
        _set-expected-label(k, label);
        Left(Unit)
      }
    }
  }
}

constant any-rune<c>: zonk(c, rune) {
  satisfy(static "any character", (_) => {
    True
  })
}

define _chunk-body<c>(k: &zonk-kit(c), chunk-string: &string) -> int {
  let input-stream = _get-input-stream(k);
  let cursor = _get-cursor(k);
  let len1 = byte-length(input-stream);
  let len2 = byte-length(chunk-string);
  if lt-int(sub-int(len1, cursor), len2) {
    -1
  } else-if eq-int(len2, 0) {
    1
  } else {
    let input-ptr = shift(get-content-pointer(input-stream), cursor);
    let chunk-ptr = get-content-pointer(chunk-string);
    let match-result = magic external memcmp(input-ptr, chunk-ptr, C-Size(len2));
    if ne-int(match-result, 0) {
      _set-gap-size(k, core.string.length(chunk-string));
      -1
    } else {
      _set-cursor(k, add-int(cursor, len2));
      1
    }
  }
}

inline chunk<c>(chunk-text: text) ->> zonk(c, unit) {
  (k) =>> {
    let result-flag = _chunk-body(k, from-text(chunk-text));
    if gt-int(result-flag, 0) {
      Right(Unit)
    } else {
      _set-expected-raw(k, chunk-text);
      Left(Unit)
    }
  }
}

inline _scan-while<c>(k: &zonk-kit(c), !p: (rune) -> bool) -> int {
  let input-stream = _get-input-stream(k);
  let len = byte-length(input-stream);
  let f =
    define consumer(cursor: int) -> int {
      if ge-int(cursor, len) {
        cursor
      } else {
        let r = get-rune-unchecked(input-stream, cursor);
        if p(r) {
          consumer(add-int(cursor, core.rune.size(r)))
        } else {
          cursor
        }
      }
    };
  f(_get-cursor(k))
}

inline take-while<c>(!p: (rune) -> bool) ->> zonk(c, string) {
  (k) =>> {
    let orig-cursor = _get-cursor(k);
    let end-cursor = _scan-while(k, p);
    _set-cursor(k, end-cursor);
    Right(slice-N(_get-input-stream(k), orig-cursor, sub-int(end-cursor, orig-cursor)))
  }
}

inline take-while-1<c>(!p: (rune) -> bool) ->> zonk(c, string) {
  (k) =>> {
    let orig-cursor = _get-cursor(k);
    let end-cursor = _scan-while(k, p);
    let size = sub-int(end-cursor, orig-cursor);
    if gt-int(size, 0) {
      _set-cursor(k, end-cursor);
      Right(slice-N(_get-input-stream(k), orig-cursor, size))
    } else {
      _set-expected-label(k, static "non-empty string");
      Left(Unit)
    }
  }
}

inline drop-while<c>(!p: (rune) -> bool) ->> zonk(c, unit) {
  (k) =>> {
    _set-cursor(k, _scan-while(k, p));
    Right(Unit)
  }
}

define _is-ascii-space(r: rune) -> bool {
  if eq-rune(r, ` `) {
    True
  } else-if and(le-rune(`\u{9}`, r), le-rune(r, `\u{D}`)) {
    True
  } else {
    False
  }
}

constant ascii-space<c>: zonk(c, unit) {
  drop-while(_is-ascii-space)
}

inline label<c, a>(l: text, p: zonk(c, a)) ->> zonk(c, a) {
  (k) =>> {
    let v = p(k);
    match v {
    | Right(result) =>
      Right(result)
    | Left(_) =>
      _set-expected-label(k, l);
      Left(Unit)
    }
  }
}

inline _rewind<c>(k: &zonk-kit(c), cursor: int, gap-size: int) -> unit {
  _set-cursor(k, cursor);
  _reset-gap-size(k, gap-size)
}

inline attempt<c, a>(p: zonk(c, a)) ->> zonk(c, a) {
  (k) =>> {
    let cursor = _get-cursor(k);
    let gap-size = _get-gap-size(k);
    match p(k) {
    | Right(result) =>
      Right(result)
    | Left(_) =>
      _rewind(k, cursor, gap-size);
      Left(Unit)
    }
  }
}

inline look-ahead<c, a>(p: zonk(c, a)) ->> zonk(c, a) {
  (k) =>> {
    let cursor = _get-cursor(k);
    let gap-size = _get-gap-size(k);
    match p(k) {
    | Right(result) =>
      _rewind(k, cursor, gap-size);
      Right(result)
    | Left(_) =>
      Left(Unit)
    }
  }
}

define _optional-body<a>(v: parsed(a)) -> parsed(?a) {
  match v {
  | Right(result) =>
    Right(Right(result))
  | Left(_) =>
    Right(Left(Unit))
  }
}

inline optional<c, a>(p: zonk(c, a)) ->> zonk(c, ?a) {
  (k) =>> {
    _optional-body(p(k))
  }
}

inline branch<c, a>(p1: zonk(c, a), p2: zonk(c, a)) ->> zonk(c, a) {
  (k) =>> {
    match p1(k) {
    | Right(result) =>
      Right(result)
    | Left(_) =>
      p2(k)
    }
  }
}

inline not-followed-by<c, a>(label: text, p: zonk(c, a)) ->> zonk(c, unit) {
  (k) =>> {
    let cursor = _get-cursor(k);
    let gap-size = _get-gap-size(k);
    let v = p(k);
    _rewind(k, cursor, gap-size);
    match v {
    | Left(_) =>
      Right(Unit)
    | Right(_) =>
      _set-gap-size(k, 1);
      _set-expected-label(k, label);
      Left(Unit)
    }
  }
}

define _choice<c, a>(
  k: &zonk-kit(c),
  label: text,
  candidates: list(zonk(c, a)),
  fallback: zonk(c, a),
  default-gap-size: int,
) ->> parsed(a) {
  match candidates {
  | Nil =>
    match fallback(k) {
    | Right(v) =>
      _set-gap-size(k, default-gap-size);
      Right(v)
    | Left(_) =>
      _set-expected-label(k, label);
      Left(Unit)
    }
  | Cons(cand, rest) =>
    match cand(k) {
    | Right(v) =>
      _set-gap-size(k, default-gap-size);
      Right(v)
    | Left(_) =>
      _choice(k, label, rest, fallback, default-gap-size)
    }
  }
}

inline choice<c, a>(label: text, candidates: list(zonk(c, a)), fallback: zonk(c, a)) ->> zonk(c, a) {
  (k) =>> {
    match candidates {
    | Nil =>
      fallback(k)
    | Cons(p, rest) =>
      let old-cursor = _get-cursor(k);
      match p(k) {
      | Right(v) =>
        Right(v)
      | Left(_) =>
        let new-cursor = _get-cursor(k);
        if eq-int(old-cursor, new-cursor) {
          let gap-size = _get-gap-size(k);
          _choice(k, label, rest, fallback, gap-size)
        } else {
          Left(Unit)
        }
      }
    }
  }
}

inline many<c, a>(!p: zonk(c, a)) -> zonk(c, list(a)) {
  (k) =>> {
    let f =
      define self(acc: list(a)) ->> parsed(list(a)) {
        match p(k) {
        | Right(v) =>
          self(Cons(v, acc))
        | Left(_) =>
          Right(reverse(acc))
        }
      };
    f(Nil)
  }
}

inline some<c, a>(!p: zonk(c, a)) ->> zonk(c, list(a)) {
  (k) =>> {
    try v = p(k);
    try vs = many(p)(k);
    Right(Cons(v, vs))
  }
}

inline scan-while<c, a>(
  label: text,
  !p: (rune) -> bool,
  interpret: (&string) -> +?a,
) ->> zonk(c, a) {
  (k) =>> {
    let orig-cursor = _get-cursor(k);
    let end-cursor = _scan-while(k, p);
    _set-cursor(k, end-cursor);
    let size = sub-int(end-cursor, orig-cursor);
    let result =
      with-byte-slice(_get-input-stream(k), orig-cursor, size, (slice) => {
        interpret(slice)
      });
    match result {
    | Right(v) =>
      Right(v)
    | Left(_) =>
      _set-gap-size(k, max-int(size, 1));
      _set-expected-label(k, label);
      Left(Unit)
    }
  }
}
