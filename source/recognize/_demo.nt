import {
  this.recognize {recognize},
  this.regex {Any, Choose, Chunk, End-Of-Input, Join, Repeat},
}

define zen() -> unit {
  let reg =
    Join(List[
      Repeat(
        Join(List[
          Choose(
            static "variable",
            List[
              Chunk(static "pqr"),
              Chunk(static "H"),
              Any(static "Lorem ipsum", List[`P`, `あ`, `k`]),
            ],
            Chunk(static "abc"),
          ),
          Chunk(static ":"),
          Choose(static "type", List[Chunk(static "AAAA")], Chunk(static "XX")),
          Chunk(static ", "),
        ]),
      ),
      End-Of-Input,
    ]);
  if recognize(reg, *"abc:XX, あ:AAAA, k:XX, ") {
    print("True\n")
  } else {
    print("False\n")
  }
}
